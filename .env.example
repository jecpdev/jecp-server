# JECP Hub — example environment configuration
#
# Copy this file to `.env` and fill in the required values.
# Production deployments should set these via your platform's secret manager
# (Fly.io secrets, AWS SSM, Vercel env, etc.), not via a checked-in file.

# === Required ===
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
ANTHROPIC_API_KEY=sk-ant-xxxxx

# === Hub server ===
JECP_HOST=0.0.0.0
JECP_PORT=8080
ENVIRONMENT=development

# === Anthropic (capability engine defaults) ===
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# === HTTP ===
CORS_ORIGINS=https://jecp.dev,http://localhost:3000
DB_MAX_CONNECTIONS=15
FREE_TIER_DAILY_LIMIT=10

# === Next.js bridge (Hub → operator dashboard / Provider UI) ===
# Optional. Only required if you run a companion Next.js dashboard.
NEXTJS_BASE_URL=http://localhost:3000
JECP_BRIDGE_SECRET=

# === x402 native settlement (v1.1.1+, optional) ===
# Required only if your Hub settles directly on the x402 facilitator network
# instead of (or in addition to) Stripe Connect.
# X402_FACILITATOR_URL=https://x402.example.com
# X402_FACILITATOR_PUBKEY=
# X402_FACILITATOR_CERT_PIN=
# BASE_RPC_URL=https://base-mainnet.example.com
# X402_NETWORK=base
# JECP_RELAYER_CHAIN_ID=8453
# JECP_RELAYER_KMS_KEY_ID=
